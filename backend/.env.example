# =====================================================================
# Nginx HA Proxy Manager - 後端環境設定範例
# 使用方式：複製本檔為 .env，再依實際環境修改【必填】項目
#   Windows：copy .env.example .env      Linux：cp .env.example .env
# 注意：.env 含密碼，已列入 .gitignore，請勿提交至 Git
# =====================================================================

# ---- Web ----
PORT=3000
# 設定後所有 /api 請求需帶 x-api-token 標頭；正式環境強烈建議設定
# 產生方式：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=

# ---- SQL Server ----
DB_HOST=127.0.0.1                 # 【必填】SQL Server 主機
DB_PORT=1433
DB_NAME=NginxProxyManager
DB_USER=sa                        # 【必填】建議改用專屬帳號，僅授權此資料庫
DB_PASSWORD=ChangeMe!             # 【必填】含 # 或空白時請用雙引號包起來
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ---- SSH (連線至 Ubuntu Nginx 節點) ----
# 【必填】deployer 帳號的私鑰路徑（Windows 請用正斜線，例：C:/nginx-ha-manager/keys/deployer_ed25519）
SSH_KEY_PATH=/opt/nginx-ha-manager/keys/deployer_ed25519
SSH_KEY_PASSPHRASE=
SSH_CONNECT_TIMEOUT_MS=10000

# ---- 遠端路徑與指令（需與 Ubuntu 上的 sudoers 設定一致）----
REMOTE_CONF_DIR=/etc/nginx/sites-managed
REMOTE_SSL_DIR=/etc/nginx/ssl
REMOTE_BACKUP_PATH=/tmp/nginx_backup.tar.gz
NGINX_TEST_CMD=sudo /usr/sbin/nginx -t
NGINX_RELOAD_CMD=sudo /usr/bin/systemctl reload nginx

# ---- 節點健康檢查週期（秒），0 = 停用 ----
HEALTH_INTERVAL_SEC=60
