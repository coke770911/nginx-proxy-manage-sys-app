# =====================================================================
# Nginx HA Proxy Manager - 後端環境設定範例
# 使用方式：複製本檔為 .env，再依實際環境修改【必填】項目
#   Windows：copy .env.example .env      Linux：cp .env.example .env
# 注意：.env 含密碼，已列入 .gitignore，請勿提交至 Git
# =====================================================================

# ---- Web ----
# 前後端共用此單一 port（前端 build 後由後端提供）
PORT=3000
# 若前方另有反向代理（如 Nginx/F5）才需調整；預設只信任本機代理的 X-Forwarded-For
TRUST_PROXY=loopback

# ---- 登入與 JWT ----
# 【必填】特權帳號（逗號分隔，不分大小寫），至少填一個管理者才能第一次登入
# 可登入名單 = 這裡的帳號 + 介面「帳號管理」新增並啟用的帳號；兩者都需通過 SOAP 驗證
ADMIN_ACCOUNTS=
# 【必填】JWT 簽章金鑰，至少 32 字元
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token 有效時間（例：30m、8h、1d）
JWT_EXPIRES_IN=8h
# 同一 IP + 帳號連續失敗幾次後鎖定
LOGIN_MAX_FAILURES=5
# 鎖定分鐘數
LOGIN_LOCK_MINUTES=15

# ---- SOAP 帳號驗證服務 ----
# 【必填】SOAP 服務端點（不含 ?wsdl）
SOAP_URL=
# 1.1 或 1.2
SOAP_VERSION=1.1
# SOAPAction（請依 WSDL 的 soapAction 填寫，例：http://tempuri.org/Authenticate）
SOAP_ACTION=
# 以下四項用來自動組出 Envelope：<METHOD xmlns="NAMESPACE"><USER_FIELD>帳號</USER_FIELD><PASS_FIELD>密碼</PASS_FIELD></METHOD>
SOAP_NAMESPACE=http://tempuri.org/
SOAP_METHOD=Authenticate
SOAP_USER_FIELD=username
SOAP_PASS_FIELD=password
# 選填：若 Envelope 格式較複雜，可直接填完整 XML 範本（單行，{{username}} / {{password}} 會自動帶入並 XML 跳脫）
# 設定後會忽略上面四項
SOAP_REQUEST_TEMPLATE=
# 回應內容符合此正規表示式（不分大小寫）才算驗證成功；請依服務實際回傳調整
# 例：<AuthenticateResult>true</AuthenticateResult> 可填 <AuthenticateResult>\s*true\s*</AuthenticateResult>
SOAP_SUCCESS_REGEX=>\s*true\s*<
SOAP_TIMEOUT_MS=10000
# 服務使用自簽憑證時才設 false
SOAP_TLS_VERIFY=true

# ---- SQL Server ----
# 【必填】SQL Server 主機
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=NginxProxyManager
# 【必填】建議改用專屬帳號，僅授權此資料庫
DB_USER=sa
# 【必填】含 # 或空白時請用雙引號包起來
DB_PASSWORD=ChangeMe!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ---- SSH (連線至 Ubuntu Nginx 節點) ----
# 【必填】deployer 帳號的私鑰路徑（Windows 請用正斜線，例：C:/nginx-ha-manager/keys/deployer_ed25519）
SSH_KEY_PATH=/opt/nginx-ha-manager/keys/deployer_ed25519
SSH_KEY_PASSPHRASE=
SSH_CONNECT_TIMEOUT_MS=10000

# ---- 遠端路徑與指令（需與 Ubuntu 上的 sudoers 設定一致）----
REMOTE_CONF_DIR=/etc/nginx/sites-managed
REMOTE_SSL_DIR=/etc/nginx/ssl
REMOTE_BACKUP_PATH=/tmp/nginx_backup.tar.gz
# 節點 Nginx Log 目錄（管理介面「檢視 Log」讀取 access.log / error.log；deployer 需有讀取權限，見 README）
REMOTE_LOG_DIR=/var/log/nginx
NGINX_TEST_CMD=sudo /usr/sbin/nginx -t
NGINX_RELOAD_CMD=sudo /usr/bin/systemctl reload nginx
# HTTP/2 寫法：modern = listen 443 ssl; + http2 on;（nginx 1.25.1 以上，如 Ubuntu 26.04）
# legacy = listen 443 ssl http2;（nginx 1.24 以下，如 Ubuntu 24.04）；所有節點需使用相同 nginx 版本系列
NGINX_HTTP2_SYNTAX=modern

# ---- 節點健康檢查週期（秒），0 = 停用 ----
HEALTH_INTERVAL_SEC=60
