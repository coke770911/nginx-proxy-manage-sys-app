# =====================================================================
# Nginx HA Proxy Manager - 後端環境設定範例
# 使用方式：複製本檔為 .env，再依實際環境修改【必填】項目
#   Windows：copy .env.example .env      Linux：cp .env.example .env
# 注意：.env 含密碼，已列入 .gitignore，請勿提交至 Git
# =====================================================================

# ---- Web ----
# 前後端共用此單一 port（前端 build 後由後端提供）
PORT=3000
# 若前方另有反向代理（如 Nginx/F5）才需調整；預設只信任本機代理的 X-Forwarded-For
TRUST_PROXY=loopback

# ---- 登入與 JWT ----
# 【必填】特權帳號（逗號分隔，不分大小寫），至少填一個管理者才能第一次登入
# 可登入名單 = 這裡的帳號 + 介面「帳號管理」新增並啟用的帳號；兩者都需通過 portal 認證 API 驗證
ADMIN_ACCOUNTS=
# 【必填】JWT 簽章金鑰，至少 32 字元
# 產生方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token 有效時間（例：30m、8h、1d）
JWT_EXPIRES_IN=8h
# 同一 IP + 帳號連續失敗幾次後鎖定
LOGIN_MAX_FAILURES=5
# 鎖定分鐘數
LOGIN_LOCK_MINUTES=15
# 登入圖片驗證碼（四碼數字）：true / false
LOGIN_CAPTCHA=true
# 登入失敗回應最短時間（毫秒，0–10000），避免以回應時間差判斷帳號是否存在
LOGIN_FAIL_MIN_MS=1500

# ---- 帳號驗證服務（校內 portal 認證 REST API）----
# 【必填】REST / JSON 端點（帳密驗證與 userDataConnect 共用）；來源 IP 需在服務白名單內
AUTH_API_URL=https://authapi.aeust.edu.tw/auth/vendor/portal/api.php
# 【必填】API 金鑰（以 X-Auth-Key 標頭送出），請向認證服務管理者索取；勿寫入程式碼或文件
AUTH_API_KEY=
# 呼叫逾時毫秒數（1000–60000）
AUTH_API_TIMEOUT_MS=10000
# 服務使用自簽憑證時才設 false
AUTH_API_TLS_VERIFY=true

# ---- SQL Server ----
# 【必填】SQL Server 主機
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=NginxProxyManager
# 【必填】建議改用專屬帳號，僅授權此資料庫
DB_USER=sa
# 【必填】含 # 或空白時請用雙引號包起來
DB_PASSWORD=ChangeMe!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ---- SSH (連線至 Ubuntu Nginx 節點) ----
# 【必填】deployer 帳號的私鑰路徑（Windows 請用正斜線，例：C:/nginx-ha-manager/keys/deployer_ed25519）
SSH_KEY_PATH=/opt/nginx-ha-manager/keys/deployer_ed25519
SSH_KEY_PASSPHRASE=
SSH_CONNECT_TIMEOUT_MS=10000

# ---- 遠端路徑與指令（需與 Ubuntu 上的 sudoers 設定一致）----
REMOTE_CONF_DIR=/etc/nginx/sites-managed
REMOTE_SSL_DIR=/etc/nginx/ssl
REMOTE_BACKUP_PATH=/tmp/nginx_backup.tar.gz
# 節點 Nginx Log 目錄（管理介面「檢視 Log」讀取 access.log / error.log；deployer 需有讀取權限，見 README）
REMOTE_LOG_DIR=/var/log/nginx
NGINX_TEST_CMD=sudo /usr/sbin/nginx -t
NGINX_RELOAD_CMD=sudo /usr/bin/systemctl reload nginx
# HTTP/2 寫法：modern = listen 443 ssl; + http2 on;（nginx 1.25.1 以上，如 Ubuntu 26.04）
# legacy = listen 443 ssl http2;（nginx 1.24 以下，如 Ubuntu 24.04）；所有節點需使用相同 nginx 版本系列
NGINX_HTTP2_SYNTAX=modern

# ---- PROXY protocol（F5 做 SNAT 時還原真實客戶端 IP）----
# 填 F5 送出連線的來源 IP（Self IP / SNAT 位址），空白或逗號分隔，可用 CIDR；留空 = 停用
# 啟用後每個網域另外監聽下面兩個 port（帶 proxy_protocol），F5 pool 改指到這兩個 port 並加 PROXY iRule
# 節點防火牆需另外開放：ufw allow from <F5 IP> to any port 8080,8443 proto tcp
PROXY_PROTOCOL_FROM=
PROXY_PROTOCOL_HTTP_PORT=8080
PROXY_PROTOCOL_HTTPS_PORT=8443

# ---- 切換前檢查（DNS 改指 F5 VIP 前的模擬測試）----
# 填 F5 VIP 的 IPv4（使用者連線的位址）；留空 = 停用「切換前檢查」按鈕
CUTOVER_VIP=

# ---- 節點健康檢查週期（秒），0 = 停用 ----
HEALTH_INTERVAL_SEC=60
